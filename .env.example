# ExpertSeat local development environment
# Copy to .env and adjust values for your setup.
# NEVER commit a .env file with real credentials.

# Application
APP_ENV=development
DEBUG=false

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql://expertseat:expertseat_dev@localhost:5432/expertseat

# Redis (matches docker-compose defaults)
REDIS_URL=redis://localhost:6379/0

# Auth — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters. Required in all environments.
SECRET_KEY=change-me-generate-a-real-secret-key-before-running

# Email (matches docker-compose Mailpit defaults)
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
EMAIL_FROM=noreply@expertseat.local

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
