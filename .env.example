# ExpertSeat local development environment
# Copy to .env and adjust values for your setup.
# NEVER commit a .env file with real credentials.

# Application
APP_ENV=development
DEBUG=false

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql://expertseat:expertseat_dev@localhost:5432/expertseat

# Redis (matches docker-compose defaults)
REDIS_URL=redis://localhost:6379/0

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
